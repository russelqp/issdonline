Options +FollowSymlinks
RewriteEngine on


RewriteCond %{REQUEST_URI} (.*)/$
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule (.*)/$ $1.html [L]



#RewriteCond %{REQUEST_URI} /+[^.]+$
#RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]
#las ultimas dos lineas hace que todos los enlaces terminen con /



<IfModule mod_expires.c>
<filesmatch "\.(jpg|JPG|gif|GIF|png|PNG|css|js)$">
ExpiresActive on
ExpiresDefault "access plus 30 day"
</filesmatch>
</IfModule>

# BEGIN GZIP
<ifmodule mod_deflate.c>
AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/css application/x-javascript application/javascript
</ifmodule>
# END GZIP

<ifModule mod_gzip.c>
mod_gzip_on Yes
mod_gzip_dechunk Yes
mod_gzip_item_include file .(html?|txt|css|js|php|pl)$
mod_gzip_item_include handler ^cgi-script$
mod_gzip_item_include mime ^text/.*
mod_gzip_item_include mime ^application/x-javascript.*
mod_gzip_item_exclude mime ^image/.*
mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</ifModule>



#Paginas de error personalizadas
Options -Indexes
#Options -index, oculta las carpetas sin index, para que no se vea la lista de archivos
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.html

#El siguiente codigo especifica el cache al navegador
<FilesMatch "\.(css|js|ico|pdf|flv|jpg|jpeg|png|gif|swf|mp3|mp4|woff|js|woff2|ttf|)$">
Header set Cache-Control "public"
Header set Expires "access plus 2592000 seconds"
</FilesMatch>

#El siguiente codigo habilita la compreción
<FilesMatch "\.(css|js|ico|pdf|jpg|jpeg|png|gif|php|woff|svg|ttf)$">
SetOutputFilter DEFLATE
</FilesMatch>
